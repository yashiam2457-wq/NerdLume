# ── Server & Runtime Environment ──────────────────────────────────────────────
PORT=5050
NERDYBRO_PORT=5050
NERDYBRO_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5050

# Database & Storage
NERDYBRO_DB_FILE=./data/nerdybro.sqlite3
NERDYBRO_DATA_FILE=./data/state.json
NERDYBRO_FILES_DIR=./data/generated
NERDYBRO_SESSION_TTL_DAYS=30
NERDYBRO_API_PROVIDER=ai-network
NERDYBRO_DEBUG_PROMPT=false
PLAN_UPGRADE_ALLOWED=false

# Rate Limits (requests per minute per IP)
NERDYBRO_RATE_LIMIT_LOGIN=10
NERDYBRO_RATE_LIMIT_GENERATE=20

# Trusted reverse proxies (comma-separated IPs)
NERDYBRO_TRUSTED_PROXIES=127.0.0.1,::1

# Google OAuth (Sign In with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Integration A: AI Generation Provider Keys ─────────────────────────────────
# Get Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Mistral API key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Get Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# AI Resilient Execution & Refinement
NERDYBRO_REFINEMENT_PASSES=2
AI_MAX_RETRIES=2
AI_RETRY_DELAY=1.0
AI_REQUEST_TIMEOUT=60

# ── Integration B: Razorpay Payment Gateway ────────────────────────────────────
# Obtain credentials from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret configured in Razorpay Dashboard: Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Integration C: Transactional Email Infrastructure ──────────────────────────
# Select provider: 'smtp' or 'resend'
EMAIL_PROVIDER=smtp

# SMTP Configuration (Standard TLS / Port 587 or SSL / Port 465)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@nerdlume.in
SMTP_FROM_NAME=NerdLume

# Resend API Configuration (Alternative provider)
# Obtain key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
